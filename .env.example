# ================================================================
# OpenClaw WordPress, WhatsApp & Product Hunt Configuration
# ================================================================

# WordPress REST API Settings
WP_BASE_URL=https://wordpress.yourdomain.com
WP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OpenRouter AI API (for SEO articles & social/directory copywriting)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# WhatsApp Notification & Command Center Target
# E.164 phone number format without spaces (e.g. +1234567890)
TARGET_PHONE_NUMBER=+1234567890
AUTHORIZED_NUMBERS=+1234567890

# Optional: Bluesky Social Syndication
BLUESKY_BOT_CLI=
BLUESKY_AUTO_POST=false
